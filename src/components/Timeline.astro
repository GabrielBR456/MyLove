---
import { render } from 'astro:content';

const { momentos } = Astro.props;
---

<div class="relative border-l-2 border-indigo-200 ml-4 md:ml-32 space-y-12">
  {momentos.map(async (momento: any, index: number) => {
    const { Content } = await render(momento);
    
    return (
      <div class="relative pl-6 md:pl-8 group">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full border-2 border-indigo-500 bg-white group-hover:bg-indigo-500 transition-colors"></div>
        
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 hover:shadow-md transition-shadow">
          <span class="text-xs font-semibold text-indigo-500 uppercase tracking-wider">{momento.data.data}</span>
          <h3 class="text-xl font-bold text-slate-800 mt-1 mb-3">{momento.data.titulo}</h3>
          
          {momento.data.imagem && (
            <div class="w-full bg-slate-900/5 rounded-2xl overflow-hidden mb-4 flex items-center justify-center">
              <img 
                src={`${import.meta.env.BASE_URL}/${momento.data.imagem.replace(/^\/+/, '')}`} 
                alt={momento.data.titulo} 
                class="w-full max-h-[450px] object-contain shadow-inner"
              />
            </div>
          )}
          
          <div class="text-slate-600 text-sm leading-relaxed prose prose-indigo">
            <Content />
          </div>
        </div>
      </div>
    );
  })}
</div>