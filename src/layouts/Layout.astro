---
import '../styles/global.css';

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
  </head>
  <!-- O fundo agora será definido em cada section do index.astro -->
  <body class="font-sans antialiased selection:bg-indigo-200 selection:text-indigo-900 m-0 p-0">
    <slot />
  </body>
</html>